{
  "private": true,
  "scripts": {
    "build": "pnpm --filter '*' build",
    "build:check:types": "pnpm --parallel --filter './packages/*' exec attw --pack",
    "lint": "pnpm biome check .",
    "lint:ci": "pnpm biome ci .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm run build && changeset publish",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.30.0",
    "bunchee": "6.5.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
