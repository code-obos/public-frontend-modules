{
  "private": true,
  "scripts": {
    "build": "pnpm --filter '*' build",
    "build:check:types": "pnpm --parallel --filter './packages/*' exec attw --pack",
    "lint": "pnpm biome check .",
    "lint:ci": "pnpm biome ci .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm run build && changeset publish",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.30.0",
    "bunchee": "6.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
