{
  "compilerOptions": {
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2019",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
